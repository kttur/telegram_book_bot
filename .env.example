TOKEN=your-telegram-bot-token
OPENAI_API_KEY=your-openai-api-key

# Optional OPDS authentication, shared by the configured mirrors.
OPDS_USER=
OPDS_PASS=

# docker-compose sets this automatically; for a local Tor use 127.0.0.1.
# TOR_PROXY_URL=socks5h://127.0.0.1:9050
# true routes all catalog requests through Tor; onion always uses Tor.
OPDS_USE_TOR=false
OPDS_CONNECT_TIMEOUT=10
OPDS_READ_TIMEOUT=60
LOG_LEVEL=INFO
