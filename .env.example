TOKEN=your-telegram-bot-token
OPENAI_API_KEY=your-openai-api-key

# Optional OPDS authentication, shared by the configured mirrors.
OPDS_USER=
OPDS_PASS=

# docker-compose sets this automatically; for a local Tor use 127.0.0.1.
# TOR_PROXY_URL=socks5h://127.0.0.1:9050
# true routes all catalog requests through Tor; onion always uses Tor.
OPDS_USE_TOR=false
OPDS_CONNECT_TIMEOUT=10
OPDS_READ_TIMEOUT=60
# Start another mirror after this delay, keeping the previous attempt running.
OPDS_SOFT_TIMEOUT=5
# Total deadline for one attempt, including cookies, redirects and downloading.
OPDS_HARD_TIMEOUT=90
# Empty means one attempt per configured mirror; larger values repeat the list.
OPDS_MAX_ATTEMPTS=
# Keep the button loading indicator for this long, then send an editable status.
BOT_STATUS_DELAY=8
# Send book details after this cover wait; attach a slow cover in the background.
# 0 sends text immediately. Network requests still use OPDS_*_TIMEOUT.
COVER_WAIT_TIMEOUT=2
LOG_LEVEL=INFO
